# Token | https://discord.com/developers/applications -> New Application -> Bot -> Create
DISCORD_TOKEN=

# Owners | A list of owners (separated by spaces, not commas) for your bot, will have access to eval and OwnerOnly commands.
OWNERS=

# Status channel | Optional. Channel ID for the bot's online/offline status messages. Empty turns them off.
STATUS_CHANNEL_ID=

# Announcements channel | Optional. Channel ID for join and leave announcements and anti-spam kick logs. Empty turns announcements off; kick logs then go to the bot's log.
ANNOUNCEMENTS_CHANNEL_ID=

# Rules channel | Optional. Channel ID of the server's rules channel, linked from join announcements. Empty leaves the link out.
RULES_CHANNEL_ID=
